# ============================================
# CONFIGURACOES DE ENVIO DE DOCUMENTOS
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- PASTA MONITORADA ---
# Use caminho local ou pasta de rede compartilhada
# Exemplos:
#   Local:         ./documentos_envio
#   Rede Windows:  \\SERVIDOR\DocumentosContabilidade
#   Rede Linux:    /mnt/compartilhado/documentos_envio
PASTA_ENTRADA=./documentos_envio
PASTA_ENVIADOS=./documentos_enviados

# --- EMAIL (SMTP) ---
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_REMETENTE=seuemail@gmail.com
EMAIL_SENHA=sua_senha_de_app
EMAIL_NOME_REMETENTE=Contabilidade XYZ

# --- WHATSAPP (Evolution API) ---
# Evolution API eh gratuita e self-hosted: https://github.com/EvolutionAPI/evolution-api
# Voce tambem pode usar outras APIs como Twilio, Z-API, etc.
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=sua_api_key
WHATSAPP_INSTANCE=sua_instancia

# --- MENSAGEM PADRAO ---
MENSAGEM_WHATSAPP=Ola! Segue em anexo o documento da contabilidade. Qualquer duvida estamos a disposicao.
ASSUNTO_EMAIL=Documento Contabil - {nome_cliente}
MENSAGEM_EMAIL=Prezado(a) {nome_cliente},\n\nSegue em anexo o documento contabil.\n\nAtenciosamente,\nContabilidade XYZ
